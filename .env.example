# Which app to run: year5 (config/apps/year5.json) or year6
APP=year5
PORT=3000
NODE_ENV=production
# Optional: a code students must enter to sign up (recommended when the app is public)
CLASS_CODE=
# Optional: fixed secret for session tokens (otherwise one is generated in data/jwt-secret.key)
JWT_SECRET=
# Where the SQLite database lives
DATA_DIR=./data
DATA_BACKEND=sqlite
